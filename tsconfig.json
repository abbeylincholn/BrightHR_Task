{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": "src",
    "paths": {
      "components/*": ["components/*"],
      "features/*": ["features/*"],
      "fixtures/*": ["fixtures/*"],
      "utils/*": ["utils/*"]
    },
    "types": ["node", "playwright"]
  },
  "include": ["src/**/*.ts"]
}
//strict + path aliases for better type safety and cleaner imports